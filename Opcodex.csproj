<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Opcodex</RootNamespace>
    <AssemblyName>Opcodex</AssemblyName>
    <AssemblyTitle>Opcodex</AssemblyTitle>
    <Product>Opcodex</Product>
    <ApplicationIcon>newlogo\opcodex.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="tests/**;**/obj/**;**/bin/**" />
    <None Remove="tests/**;**/obj/**;**/bin/**" />
    <Resource Include="newlogo\opcodex.ico" />
  </ItemGroup>
</Project>
