<Window x:Class="Opcodex.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Opcodex"
        Title="Opcodex"
        Icon="{StaticResource AppLogo}"
        Width="1400" Height="820" MinWidth="1000" MinHeight="600" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowDrop="True" Drop="Window_Drop"
        Background="{StaticResource Bg0}" Foreground="{StaticResource Fg}"
        FontFamily="Segoe UI" FontSize="12">

  <Window.InputBindings>
    <KeyBinding Key="O" Modifiers="Ctrl" Command="ApplicationCommands.Open"/>
    <KeyBinding Key="S" Modifiers="Ctrl" Command="ApplicationCommands.Save"/>
    <KeyBinding Key="Z" Modifiers="Ctrl" Command="ApplicationCommands.Undo"/>
    <KeyBinding Key="Y" Modifiers="Ctrl" Command="ApplicationCommands.Redo"/>
    <KeyBinding Key="N" Modifiers="Ctrl" Command="{x:Static local:MainWindow.NopCommand}"/>
    <KeyBinding Key="F" Modifiers="Ctrl" Command="ApplicationCommands.Find"/>
    <KeyBinding Key="G" Modifiers="Ctrl" Command="{x:Static local:MainWindow.GotoCommand}"/>
  </Window.InputBindings>
  <Window.CommandBindings>
    <CommandBinding Command="ApplicationCommands.Open" Executed="OpenCmd_Executed"/>
    <CommandBinding Command="ApplicationCommands.Save" Executed="SaveCmd_Executed"/>
    <CommandBinding Command="ApplicationCommands.Undo" Executed="UndoCmd_Executed"/>
    <CommandBinding Command="ApplicationCommands.Redo" Executed="RedoCmd_Executed"/>
    <CommandBinding Command="{x:Static local:MainWindow.NopCommand}" Executed="NopCmd_Executed"/>
    <CommandBinding Command="ApplicationCommands.Find" Executed="FindCmd_Executed"/>
    <CommandBinding Command="{x:Static local:MainWindow.GotoCommand}" Executed="GotoCmd_Executed"/>
  </Window.CommandBindings>

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Border x:Name="Root" BorderBrush="{StaticResource Accent}" BorderThickness="1">
  <Grid>
  <DockPanel>


    <Grid DockPanel.Dock="Top" Height="34" Background="{StaticResource Bg1}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Menu x:Name="TopMenu" Grid.Column="0" Background="Transparent" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
      <MenuItem Header="_File">
        <MenuItem Header="Open .pyc..." InputGestureText="Ctrl+O" Click="Open_Click"/>
        <MenuItem Header="Save patched .pyc" InputGestureText="Ctrl+S" Click="Save_Click"/>
        <MenuItem Header="Export disassembly (.txt)" Click="Export_Click"/>
        <MenuItem Header="Export source (.py)..." Click="ExportSource_Click"/>
        <MenuItem Header="Exit" InputGestureText="Alt+F4" Click="Quit_Click"/>
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem Header="NOP instruction" InputGestureText="Ctrl+N" Click="Nop_Click"/>
        <MenuItem Header="Undo" InputGestureText="Ctrl+Z" Click="Undo_Click"/>
        <MenuItem Header="Redo" InputGestureText="Ctrl+Y" Click="Redo_Click"/>
        <MenuItem Header="Find in view..." InputGestureText="Ctrl+F" Click="Find_Click"/>
        <MenuItem Header="Search all code objects..." Click="GlobalSearch_Click"/>
        <MenuItem Header="Go to offset..." InputGestureText="Ctrl+G" Click="Goto_Click"/>
      </MenuItem>
      <MenuItem Header="_Analysis">
        <MenuItem Header="List constants" Tag="0" Click="ShowTab_Click"/>
        <MenuItem Header="List names / globals" Tag="1" Click="ShowTab_Click"/>
        <MenuItem Header="Extract strings" Tag="2" Click="ShowTab_Click"/>
        <MenuItem Header="Behavior flags" Click="ShowFlags_Click"/>
        <MenuItem Header="Copy flags report" Click="FlagsReport_Click"/>
        <MenuItem Header="Control flow graph" Click="Cfg_Click"/>
        <MenuItem Header="Cross-references" Click="XRefs_Click"/>
      </MenuItem>
      <MenuItem Header="_Patch">
        <MenuItem Header="Assemble instruction..." Click="Assemble_Click"/>
        <MenuItem Header="Invert conditional jump" Click="Invert_Click"/>
        <MenuItem Header="Rebuild header / marshal" Click="Rebuild_Click"/>
      </MenuItem>
      <MenuItem Header="_Help"><MenuItem Header="About" Click="About_Click"/></MenuItem>
    </Menu>
      <TextBlock Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource Muted}" IsHitTestVisible="False"/>
      <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
        <Button Style="{StaticResource CaptionBtn}" Click="Min_Click">
          <Path Data="M0,5 H10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10" Stretch="None" SnapsToDevicePixels="True"/>
        </Button>
        <Button Style="{StaticResource CaptionBtn}" Click="Max_Click">
          <Path x:Name="MaxIcon" Data="M0.5,0.5 H9.5 V9.5 H0.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10" Stretch="None" SnapsToDevicePixels="True"/>
        </Button>
        <Button Style="{StaticResource CloseBtn}" Click="Quit_Click">
          <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Width="10" Height="10" Stretch="None"/>
        </Button>
      </StackPanel>
    </Grid>


    <Border DockPanel.Dock="Top" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,1" Padding="4,2">
      <DockPanel>
        <Grid DockPanel.Dock="Right" Width="240" VerticalAlignment="Center">
          <TextBox x:Name="SearchBox" Text="Search opcode, const, name..." Foreground="{StaticResource Muted}" Padding="26,3,4,3" GotFocus="Search_GotFocus" LostFocus="Search_LostFocus" KeyDown="Search_KeyDown"/>
          <Path Style="{StaticResource Ico}" Data="{StaticResource IcoSearch}" Stroke="{StaticResource Muted}" HorizontalAlignment="Left" Margin="8,0,0,0" Width="12" Height="12" IsHitTestVisible="False"/>
        </Grid>
        <StackPanel Orientation="Horizontal">
          <Button Tag="Open" Click="Open_Click"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoOpen}"/><TextBlock Text="Open"/></StackPanel></Button>
          <Button Tag="Save" Click="Save_Click"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoSave}"/><TextBlock Text="Save"/></StackPanel></Button>
          <Border Width="1" Background="{StaticResource Line}" Margin="6,2"/>
          <Button Tag="NOP" Click="Nop_Click"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoBan}"/><TextBlock Text="NOP"/></StackPanel></Button>
          <Button Tag="Patch" Click="Apply_Click"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoPencil}"/><TextBlock Text="Patch"/></StackPanel></Button>
          <Button Tag="Undo" Click="Undo_Click"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoUndo}"/><TextBlock Text="Undo"/></StackPanel></Button>
          <Button Tag="Redo" Click="Redo_Click"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoRedo}"/><TextBlock Text="Redo"/></StackPanel></Button>
          <Border Width="1" Background="{StaticResource Line}" Margin="6,2"/>
          <Button Tag="CFG" Click="Cfg_Click"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoGraph}"/><TextBlock Text="CFG"/></StackPanel></Button>
          <Button Tag="XRefs" Click="XRefs_Click"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoTarget}"/><TextBlock Text="XRefs"/></StackPanel></Button>
          <Button Tag="Rebuild" Click="Rebuild_Click"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource Ico}" Data="{StaticResource IcoRefresh}"/><TextBlock Text="Rebuild"/></StackPanel></Button>
        </StackPanel>
      </DockPanel>
    </Border>


    <Border DockPanel.Dock="Bottom" Background="{StaticResource Accent}" Padding="10,3">
      <DockPanel TextElement.Foreground="White">
        <TextBlock DockPanel.Dock="Right" Text="No file loaded"
                   x:Name="StatusRight"/>
        <TextBlock x:Name="StatusLeft" Text="Ready"/>
      </DockPanel>
    </Border>


    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260"/>
        <ColumnDefinition Width="4"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="4"/>
        <ColumnDefinition Width="300"/>
      </Grid.ColumnDefinitions>


      <Grid Grid.Column="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="*" MinHeight="100"/>
          <RowDefinition Height="4"/>
          <RowDefinition Height="320" MinHeight="100"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
          <TabItem Header="Code objects">
            <TreeView x:Name="CodeTree" SelectedItemChanged="CodeTree_SelectedItemChanged"/>
          </TabItem>
          <TabItem Header="Imports">
            <ListBox x:Name="ImportsList" FontFamily="Consolas"/>
          </TabItem>
        </TabControl>

        <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      ResizeBehavior="PreviousAndNext" ResizeDirection="Rows"/>

        <DockPanel Grid.Row="2" Background="{StaticResource Bg1}">
          <Border DockPanel.Dock="Top" Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}"
                  BorderThickness="0,0,0,1" Padding="8,5">
            <DockPanel>
              <TextBlock x:Name="FlagCountText" DockPanel.Dock="Right" Text="0"
                         Foreground="{StaticResource Muted}" Margin="8,0,0,0"/>
              <TextBlock Text="BEHAVIOR FLAGS" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/>
            </DockPanel>
          </Border>
          <Grid>
            <TreeView x:Name="FlagTree" Visibility="Collapsed"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      PreviewMouseLeftButtonDown="FlagTree_Down" PreviewMouseLeftButtonUp="FlagTree_Click"
                      KeyDown="FlagTree_KeyDown">
              <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                  <Setter Property="IsExpanded" Value="False"/>
                </Style>
              </TreeView.ItemContainerStyle>
              <TreeView.Resources>
                <!-- Level 1: triggered flag, text coloured by severity -->
                <HierarchicalDataTemplate DataType="{x:Type local:FlagGroupView}" ItemsSource="{Binding Rows}">
                  <StackPanel Orientation="Horizontal" ToolTip="{Binding ToolTipText}">
                    <TextBlock Text="{Binding Label}" Foreground="{Binding Color}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding EvidenceCount}" Foreground="{StaticResource Muted}" Margin="7,0,0,0"/>
                  </StackPanel>
                </HierarchicalDataTemplate>
                <!-- Level 2: what triggered it, one short line; a click jumps to the code -->
                <DataTemplate DataType="{x:Type local:FlagRow}">
                  <TextBlock Text="{Binding Preview}" Foreground="{StaticResource Fg}" Cursor="Hand"
                             MaxWidth="220" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                             ToolTip="{Binding FullToolTip}" Margin="0,1"/>
                </DataTemplate>
              </TreeView.Resources>
            </TreeView>
            <TextBlock x:Name="FlagEmptyText" Text="Open a .pyc file to scan for behavior flags"
                       Foreground="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap"
                       VerticalAlignment="Center" Margin="12" IsHitTestVisible="False"/>
          </Grid>
        </DockPanel>
      </Grid>
      <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch"/>


      <Grid Grid.Column="2">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="4"/>
          <RowDefinition Height="240"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="CenterTabs" Grid.Row="0" SelectionChanged="CenterTabs_SelectionChanged">
          <TabItem x:Name="DisasmTab" Header="Disassembly">
            <ListView x:Name="Disasm" FontFamily="Consolas" FontSize="13"
                      SelectionChanged="Disasm_SelectionChanged" MouseDoubleClick="Disasm_DoubleClick"
                      PreviewMouseRightButtonDown="Disasm_PreviewRightDown" ContextMenuOpening="Disasm_ContextMenuOpening"
                      VirtualizingPanel.IsVirtualizing="True">
              <ListView.ContextMenu>
                <ContextMenu x:Name="DisasmMenu" Opened="DisasmMenu_Opened">
                  <MenuItem Header="Copy instruction(s)" Click="CopyInsn_Click"/>
                  <MenuItem Header="Copy opcode" Tag="opcode" Click="CopyField_Click"/>
                  <MenuItem Header="Copy argument" Tag="arg" Click="CopyField_Click"/>
                  <MenuItem Header="Copy operand / value" Tag="operand" Click="CopyField_Click"/>
                  <MenuItem Header="Copy offset" Tag="offset" Click="CopyField_Click"/>
                  <MenuItem Header="Copy bytes (hex)" Tag="bytes" Click="CopyField_Click"/>
                  <Separator/>
                  <MenuItem Header="Copy whole routine (this code object)" Click="CopyRoutine_Click"/>
                  <MenuItem Header="Copy whole file disassembly" Click="CopyFileDis_Click"/>
                  <Separator/>
                  <MenuItem x:Name="CmGoto" Header="Go to jump target" Click="CmGoto_Click"/>
                  <MenuItem Header="Cross-references" Click="XRefs_Click"/>
                  <Separator/>
                  <MenuItem Header="NOP" InputGestureText="Ctrl+N" Click="Nop_Click"/>
                  <MenuItem Header="Assemble instruction..." Click="Assemble_Click"/>
                  <MenuItem x:Name="CmInvert" Header="Invert conditional jump" Click="Invert_Click"/>
                  <MenuItem Header="Delete instruction" Click="DeleteInsn_Click"/>
                </ContextMenu>
              </ListView.ContextMenu>
              <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                  <Setter Property="Background" Value="{Binding RowBrush}"/>
                </Style>
              </ListView.ItemContainerStyle>
              <ListView.View>
                <GridView>
                  <GridViewColumn Header="" Width="26">
                    <GridViewColumn.CellTemplate><DataTemplate><Path x:Name="P" Style="{StaticResource Ico}" Data="{StaticResource IcoPencil}" Stroke="#F44747" Width="11" Height="11" HorizontalAlignment="Center" Margin="0"/><DataTemplate.Triggers><DataTrigger Binding="{Binding Marker}" Value=""><Setter TargetName="P" Property="Visibility" Value="Hidden"/></DataTrigger></DataTemplate.Triggers></DataTemplate></GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Offset" Width="70">
                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Offset}" Foreground="#B5CEA8"/></DataTemplate></GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Bytes" Width="80">
                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Bytes}" Foreground="#808080"/></DataTemplate></GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Opcode" Width="250">
                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Opcode}" Foreground="{Binding OpBrush}" FontWeight="SemiBold"/></DataTemplate></GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Arg" Width="50">
                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Arg}" Foreground="#B5CEA8"/></DataTemplate></GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Operand" Width="240">
                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Operand}" Foreground="#CE9178"/></DataTemplate></GridViewColumn.CellTemplate>
                  </GridViewColumn>
                  <GridViewColumn Header="Comment" Width="400">
                    <GridViewColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Comment}" Foreground="#6A9955" FontStyle="Italic"/></DataTemplate></GridViewColumn.CellTemplate>
                  </GridViewColumn>
                </GridView>
              </ListView.View>
            </ListView>
          </TabItem>
          <TabItem x:Name="PseudoTab" Header="Pseudo-source">
            <ScrollViewer x:Name="PseudoScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">


              <Grid Margin="0,10" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="PseudoLines" Grid.Column="0" VerticalAlignment="Top" FontFamily="Consolas" FontSize="13" LineHeight="18" LineStackingStrategy="BlockLineHeight"
                           TextAlignment="Right" Foreground="{StaticResource Muted}" MinWidth="48" Padding="8,0,12,0"/>
                <Border Grid.Column="1" VerticalAlignment="Top" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                  <Grid>
                    <RichTextBox x:Name="Pseudo" IsReadOnly="True" IsReadOnlyCaretVisible="True" IsDocumentEnabled="False"
                                 IsInactiveSelectionHighlightEnabled="True"
                                 BorderThickness="0" Background="Transparent" Foreground="{StaticResource Fg}"
                                 FontFamily="Consolas" FontSize="13" Padding="10,0,14,0" Width="600" MinHeight="20"
                                 HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
                      <RichTextBox.ContextMenu>
                        <ContextMenu>
                          <MenuItem Header="Copy" InputGestureText="Ctrl+C" Click="PseudoCopy_Click"/>
                          <MenuItem Header="Select all" InputGestureText="Ctrl+A" Click="PseudoSelectAll_Click"/>
                          <MenuItem Header="Find..." InputGestureText="Ctrl+F" Click="Find_Click"/>
                          <Separator/>
                          <MenuItem Header="Copy whole source of this code object" Click="PseudoCopyAll_Click"/>
                          <MenuItem Header="Export source (.py)..." Click="ExportSource_Click"/>
                        </ContextMenu>
                      </RichTextBox.ContextMenu>
                    </RichTextBox>

                    <Canvas x:Name="PseudoOverlay" IsHitTestVisible="False"/>
                  </Grid>
                </Border>
              </Grid>
            </ScrollViewer>
          </TabItem>
        </TabControl>


        <Border x:Name="FindBar" Grid.Row="0" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,34,24,0"
                Background="{StaticResource Bg2}" BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="6,4">
          <StackPanel Orientation="Horizontal">
            <TextBox x:Name="FindBox" Width="210" TextChanged="FindBox_TextChanged" KeyDown="FindBox_KeyDown"/>
            <TextBlock x:Name="FindCount" MinWidth="70" Margin="8,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
            <Button Content="&#x25B2;" Padding="7,3" ToolTip="Previous (Shift+Enter)" Click="FindPrev_Click"/>
            <Button Content="&#x25BC;" Padding="7,3" ToolTip="Next (Enter)" Click="FindNext_Click"/>
            <Button Content="&#x2715;" Padding="7,3" ToolTip="Close (Esc)" Click="FindClose_Click"/>
          </StackPanel>
        </Border>

        <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch"/>

        <TabControl x:Name="BottomTabs" Grid.Row="2">
          <TabItem Header="Constants">
            <ListView x:Name="ConstList" FontFamily="Consolas" MouseDoubleClick="RefList_DoubleClick">
              <ListView.View><GridView>
                <GridViewColumn Header="#" Width="50" DisplayMemberBinding="{Binding Index}"/>
                <GridViewColumn Header="Type" Width="100" DisplayMemberBinding="{Binding Type}"/>
                <GridViewColumn Header="Value" Width="380" DisplayMemberBinding="{Binding Value}"/>
                <GridViewColumn Header="Refs" Width="120" DisplayMemberBinding="{Binding Refs}"/>
              </GridView></ListView.View>
            </ListView>
          </TabItem>
          <TabItem Header="Names">
            <ListView x:Name="NameList" FontFamily="Consolas" MouseDoubleClick="RefList_DoubleClick">
              <ListView.View><GridView>
                <GridViewColumn Header="#" Width="50" DisplayMemberBinding="{Binding Index}"/>
                <GridViewColumn Header="Type" Width="100" DisplayMemberBinding="{Binding Type}"/>
                <GridViewColumn Header="Name" Width="380" DisplayMemberBinding="{Binding Value}"/>
                <GridViewColumn Header="Refs" Width="120" DisplayMemberBinding="{Binding Refs}"/>
              </GridView></ListView.View>
            </ListView>
          </TabItem>
          <TabItem Header="Strings">
            <ListView x:Name="StringList" FontFamily="Consolas" MouseDoubleClick="RefList_DoubleClick">
              <ListView.View><GridView>
                <GridViewColumn Header="#" Width="50" DisplayMemberBinding="{Binding Index}"/>
                <GridViewColumn Header="Type" Width="100" DisplayMemberBinding="{Binding Type}"/>
                <GridViewColumn Header="Value" Width="380" DisplayMemberBinding="{Binding Value}"/>
                <GridViewColumn Header="Refs" Width="120" DisplayMemberBinding="{Binding Refs}"/>
              </GridView></ListView.View>
            </ListView>
          </TabItem>
          <TabItem Header="Patches">
            <ListView x:Name="PatchList" FontFamily="Consolas">
              <ListView.View><GridView>
                <GridViewColumn Header="Offset" Width="80" DisplayMemberBinding="{Binding Index}"/>
                <GridViewColumn Header="Original" Width="230" DisplayMemberBinding="{Binding Type}"/>
                <GridViewColumn Header="Patched" Width="230" DisplayMemberBinding="{Binding Value}"/>
                <GridViewColumn Header="Time" Width="100" DisplayMemberBinding="{Binding Refs}"/>
              </GridView></ListView.View>
            </ListView>
          </TabItem>
          <TabItem Header="Header">
            <ListView x:Name="HeaderList" FontFamily="Consolas">
              <ListView.View><GridView>
                <GridViewColumn Header="Field" Width="170" DisplayMemberBinding="{Binding Index}"/>
                <GridViewColumn Header="Value" Width="520" DisplayMemberBinding="{Binding Value}"/>
              </GridView></ListView.View>
            </ListView>
          </TabItem>
          <TabItem Header="Log"><ListBox x:Name="LogList" FontFamily="Consolas" Foreground="{StaticResource Muted}"/></TabItem>
        </TabControl>
      </Grid>
      <GridSplitter Grid.Column="3" HorizontalAlignment="Stretch"/>


      <DockPanel Grid.Column="4" Background="{StaticResource Bg1}">
        <Border DockPanel.Dock="Top" Background="{StaticResource Bg2}" Padding="10,6" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
          <TextBlock Text="CODE OBJECT PROPERTIES" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/>
        </Border>
        <ListView x:Name="PropList" DockPanel.Dock="Top" Height="200" Background="{StaticResource Bg1}" FontFamily="Consolas">
          <ListView.View><GridView>
            <GridViewColumn Header="Field" Width="110" DisplayMemberBinding="{Binding Index}"/>
            <GridViewColumn Header="Value" Width="170" DisplayMemberBinding="{Binding Value}"/>
          </GridView></ListView.View>
        </ListView>

        <Border DockPanel.Dock="Top" Background="{StaticResource Bg2}" Padding="10,6" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,1">
          <TextBlock Text="INSPECTOR / PATCH" Foreground="{StaticResource Muted}" FontWeight="SemiBold"/>
        </Border>
        <StackPanel DockPanel.Dock="Top" Margin="10">
          <TextBlock x:Name="InspTitle" Text="No instruction selected" FontFamily="Consolas" Foreground="#DCDCAA" TextWrapping="Wrap"/>
          <TextBlock x:Name="InspBytes" Text="" FontFamily="Consolas" Foreground="{StaticResource Muted}" Margin="0,4,0,10"/>
          <TextBlock Text="New instruction" Foreground="{StaticResource Muted}" Margin="0,0,0,3"/>
          <TextBox x:Name="PatchBox" FontFamily="Consolas" Text="LOAD_CONST 3"/>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Apply" Click="Apply_Click"/>
            <Button Content="NOP" Click="Nop_Click"/>
            <Button Content="Undo" Click="Undo_Click"/>
            <Button Content="Redo" Click="Redo_Click"/>
          </StackPanel>
        </StackPanel>
        <Border/>
      </DockPanel>
    </Grid>
  </DockPanel>


  <Grid x:Name="LoadOverlay" Visibility="Collapsed" Background="#99000000" Margin="0,34,0,0" Panel.ZIndex="100">
    <Border Width="480" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource Bg1}"
            BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="22,18">
      <StackPanel>
        <TextBlock x:Name="LoadTitle" Text="Loading..." FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
        <TextBlock x:Name="LoadStage" Foreground="{StaticResource Muted}" Margin="0,4,0,12" TextTrimming="CharacterEllipsis"/>
        <ProgressBar x:Name="LoadBar" Style="{StaticResource LoadBarStyle}" Minimum="0" Maximum="100" Height="8"/>
        <DockPanel Margin="0,10,0,0">
          <Button x:Name="LoadCancel" DockPanel.Dock="Right" Content="Cancel" Click="LoadCancel_Click"/>
          <TextBlock x:Name="LoadPct" Text="0 %" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
        </DockPanel>
      </StackPanel>
    </Border>
  </Grid>
  </Grid>
  </Border>
</Window>
